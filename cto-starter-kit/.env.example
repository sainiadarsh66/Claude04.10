# Copy this file to `.env` and fill in real values. NEVER commit `.env`.
# In the cloud, set these in the Vercel / Railway dashboard instead.

# --- General ---
NODE_ENV=development
APP_URL=http://localhost:3000
API_URL=http://localhost:4000

# --- Database (local Docker default; Neon gives you a URL in its dashboard) ---
DATABASE_URL=postgres://app:app@localhost:5432/app

# --- Redis (local Docker default; Upstash gives you a URL in its dashboard) ---
REDIS_URL=redis://localhost:6379

# --- Auth (Clerk dashboard → API Keys) ---
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
CLERK_WEBHOOK_SIGNING_SECRET=

# --- Email (Resend) ---
RESEND_API_KEY=
EMAIL_FROM=hello@yourdomain.com

# --- Payments (Stripe, use TEST keys until launch) ---
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=

# --- File storage (Cloudflare R2 / S3) ---
S3_ENDPOINT=
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# --- Monitoring ---
SENTRY_DSN=
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://eu.i.posthog.com
